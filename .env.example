# ── snipe.dev environment ─────────────────────────────
# Copy to .env and fill in your Supabase project values
# (Dashboard → Project Settings → API).

# Project URL, e.g. https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=

# Project anon (public) key — safe to expose in the browser.
VITE_SUPABASE_ANON_KEY=

# GitHub OAuth is configured in Supabase Dashboard → Auth → Providers.
# For local edge-function debugging use the local CLI:
#   supabase start   → functions run at http://127.0.0.1:54321/functions/v1
VITE_SUPABASE_FUNCTIONS_URL=